# Copy to .env and fill in. Never commit .env.

# --- Notion (read-only integration connected to the Leave Tracker page) ---
NOTION_TOKEN=
# Leave_tracker_db (the inline database on the ✈️ Leave Tracker page)
NOTION_LEAVE_DB_ID=1519ca8db0d780318790d7765732736f
# Team Members: people whose Employment Status isn't Active are hidden; live leave balances come from here
NOTION_TEAM_DB_ID=d1b0d315d37e4a91a28dea8b30e96cbd
# Changed rows are picked up every NOTION_SYNC_SEC; everything is re-read every NOTION_FULL_SYNC_SEC (catches deletions)
NOTION_SYNC_SEC=60
NOTION_FULL_SYNC_SEC=1800

# --- App ---
PORT=8090
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

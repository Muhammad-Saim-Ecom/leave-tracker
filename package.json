{
  "name": "leave-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Leave dashboard for EcomExperts: approvals, who's out, calendar, finance queue and per-person history, read live from the Notion Leave Tracker.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "check": "tsx src/cli/check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
